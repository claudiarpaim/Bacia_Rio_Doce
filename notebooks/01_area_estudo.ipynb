    "def encontrar_raiz_projeto(marcador=\".git\"):\n",
    "    caminho = Path.cwd()\n",
    "    for pasta in [caminho, *caminho.parents]:\n",
    "        if (pasta / marcador).exists():\n",
    "            return pasta\n",
    "    raise FileNotFoundError(\"Diretório raiz do projeto não encontrado.\")\n",
    "\n",
    "ROOT = encontrar_raiz_projeto()
   ]
